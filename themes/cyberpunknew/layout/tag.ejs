<% var posts = page.posts ? page.posts.sort('-date').toArray() : []; %>
<main id="main" class="cb-main">
    <header class="cb-page-head cb-on-ink">
        <div class="cb-shell cb-page-head-inner">
            <p class="cb-label">标签</p>
            <h1 class="cb-page-title">#<%= page.tag %></h1>
            <p class="cb-page-sub">共 <%= posts.length %> 篇文章</p>
        </div>
        <div class="cb-hazard" aria-hidden="true"></div>
    </header>

    <div class="cb-shell cb-page-body">
        <%- partial('_partial/timeline', { posts: posts }) %>
    </div>
</main>
