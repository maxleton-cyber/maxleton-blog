<% if (theme.highlightjs && theme.highlightjs.enable !== false && (is_post() || is_page())) { %>
<% var hlTheme = theme.highlightjs.theme || 'atom-one-dark'; %>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/highlightjs/cdn-release@11.11.1/build/styles/<%= hlTheme %>.min.css">
<link rel="stylesheet" href="https://unpkg.com/highlightjs-copy@1.0.6/dist/highlightjs-copy.min.css">
<script defer data-cfasync="false" src="https://cdn.jsdelivr.net/gh/highlightjs/cdn-release@11.11.1/build/highlight.min.js"></script>
<script defer data-cfasync="false" src="https://unpkg.com/highlightjs-copy@1.0.6/dist/highlightjs-copy.min.js"></script>
<% } %>
